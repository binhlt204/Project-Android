<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Khi nút được chọn -->
    <item android:state_selected="true" android:drawable="@color/gray" />

    <!-- Khi nút được nhấn -->
    <item android:state_pressed="true" android:drawable="@color/gray" />

    <!-- Khi nút bị vô hiệu hóa -->
    <item android:state_enabled="false" android:drawable="@color/gray" />

    <!-- Trạng thái mặc định -->
    <item android:drawable="@color/gray" />
</selector>
